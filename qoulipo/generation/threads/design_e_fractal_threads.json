{
  "title": "Le Livre Fractal — Self-Similar Coastline",
  "target_property": "self_similar_graph",
  "mechanism": "hierarchical_circulant_C5_x_C10",
  "description": "Self-similar graph: inter-chapter structure (cycle C5) mirrors intra-chapter structure (circulant C(10,{1,2})). Each chapter is a miniature of the whole book. 5 macro-threads control chapter identity (adjacent chapters share 1 macro). 10 micro-threads control intra-chapter position (sliding window, step 1, width 3). Each page: 2 macro + 3 micro = 5 threads.",
  "fractal_property": "The graph at PAGE resolution within each chapter has the same circulant topology as the graph at CHAPTER resolution across the whole book. Zoom into any chapter and you see the same structure as the whole.",
  "literary_conceit": "Mandelbrot meets Nithard. The coastline of France at every scale. Three voices: Nithard (the mapmaker), Pascal (the measurer), the Professor (the fractal theorist).",
  "macro_threads": [
    {"id": "COASTLINE", "domain": "Shores, borders, littoral, land-sea boundary, edge measurement"},
    {"id": "SCALE", "domain": "Resolution, zoom, magnification, detail level, coarse vs fine"},
    {"id": "FRACTAL", "domain": "Self-similarity, Mandelbrot, recursion, iteration, fractal dimension"},
    {"id": "CARTOGRAPHY", "domain": "Maps, charts, projection, territory vs representation"},
    {"id": "TIDE", "domain": "Rhythm, erosion, cycle, ebb and flow, lunar pull"}
  ],
  "micro_threads": [
    {"id": "GRANITE", "index": 0, "domain": "Stone, cliff, bedrock, Breton hardness, permanence"},
    {"id": "KELP", "index": 1, "domain": "Seaweed, marine biology, underwater forest, biomass"},
