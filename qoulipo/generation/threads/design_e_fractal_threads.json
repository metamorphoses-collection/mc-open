    {"id": "CHALK", "index": 4, "domain": "White cliff, calcium, Normandy bluffs, erosion, Dover"},
    {"id": "SALT", "index": 5, "domain": "Ocean mineral, brine, preservation, saline, taste of sea"},
    {"id": "DUNE", "index": 6, "domain": "Sand hill, wind-shaped, shifting, Arcachon, Pilat"},
    {"id": "ANCHOR", "index": 7, "domain": "Mooring, harbor, weight, departure, stability"},
